{
  "type": "log_filter",
  "id": "drop-secret-auth-header",
  "action": "ACTION_DROP",
  "matchers": [
    {
      "target": {
        "log_attribute_path": {
          "segments": ["http", "headers", "authorization"]
        }
      },
      "predicate": {
        "glob": "Bearer secret-*"
      }
    }
  ]
}
