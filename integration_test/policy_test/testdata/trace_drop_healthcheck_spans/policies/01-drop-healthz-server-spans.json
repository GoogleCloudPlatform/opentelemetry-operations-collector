{
  "type": "trace_filter",
  "id": "drop-healthcheck-server-spans",
  "matchers": [
    {
      "target": {
        "record_field": "SPAN_RECORD_FIELD_KIND"
      },
      "predicate": {
        "equality": {
          "string_value": "SERVER"
        }
      }
    },
    {
      "target": {
        "span_attribute_path": {
          "segments": ["http.target"]
        }
      },
      "predicate": {
        "glob": "/healthz"
      }
    }
  ]
}
