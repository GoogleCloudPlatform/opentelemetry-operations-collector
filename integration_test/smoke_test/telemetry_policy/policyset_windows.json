{
  "description": "Telemetry Policy Windows smoke test policy set (owner: xuechun). Used by integration_test/smoke_test TestTelemetryPoliciesSmoke.",
  "receiverPolicies": [
    { "fileLogSourcePolicy": { "includedPaths": ["%SystemDrive%/gboc-smoke/*.log"] } }
  ],
  "componentPolicies": [
    {
      "logTransformPolicy": {
        "matchers": [
          {
            "target": { "recordField": "LOG_RECORD_FIELD_BODY" },
            "predicate": { "containment": { "stringValue": "gboc-smoke" } }
          }
        ],
        "additions": [
          {
            "target": { "logAttributePath": { "segments": ["gboc_smoke"] } },
            "value": { "stringValue": "true" },
            "upsertEnabled": true
          }
        ]
      }
    }
  ],
  "universalPolicies": [
    {
      "logFilterPolicy": {
        "action": "ACTION_DROP",
        "matchers": [
          {
            "target": { "recordField": "LOG_RECORD_FIELD_BODY" },
            "predicate": { "containment": { "stringValue": "gboc-smoke=drop" } }
          }
        ]
      }
    },
    {
      "logFilterPolicy": {
        "action": "ACTION_DROP",
        "matchers": [
          {
            "target": { "recordField": "LOG_RECORD_FIELD_BODY" },
            "predicate": { "containment": { "stringValue": "gboc-smoke" } },
            "negated": true
          }
        ]
      }
    }
  ]
}
