{
  "type": "log_transform",
  "id": "preserve-existing-label",
  "matches": [
    {
      "target": {
        "resource_attribute": {
          "path": ["env"]
        }
      },
      "equals": { "string_value": "prod" }
    }
  ],
  "add": {
    "target": {
      "log_attribute": {
        "path": ["existing_label"]
      }
    },
    "value": { "string_value": "overwritten" },
    "upsert": false
  }
}
