{
  "description": "GBOC Control Plane smoke test policy set. Used by integration_test/smoke_test TestControlPlaneSmoke.",
  "receiverPolicies": [
    { "fileLogSourcePolicy": { "includedPaths": ["/var/log/gboc-smoke/*.log"] } }
  ],
  "componentPolicies": [
    {
      "logTransformPolicy": {
        "matchers": [
          {
            "target": { "recordField": "LOG_RECORD_FIELD_BODY" },
            "containment": { "stringValue": "gboc-smoke" }
          }
        ],
        "addition": {
          "target": { "logAttributePath": { "segments": ["gboc_smoke"] } },
          "value": { "stringValue": "true" },
          "upsertEnabled": true
        }
      }
    }
  ],
  "universalPolicies": [
    {
      "logFilterPolicy": {
        "action": "ACTION_DROP",
        "matchers": [
          {
            "target": { "recordField": "LOG_RECORD_FIELD_BODY" },
            "containment": { "stringValue": "gboc-smoke=drop" }
          }
        ]
      }
    },
    {
      "logFilterPolicy": {
        "action": "ACTION_DROP",
        "matchers": [
          {
            "target": { "recordField": "LOG_RECORD_FIELD_BODY" },
            "containment": { "stringValue": "gboc-smoke" },
            "negated": true
          }
        ]
      }
    }
  ]
}
