# NOTE: File generated by distrogen. Do not manually edit.

dist:
  module: {{ .Module }}
  name: {{ .BinaryName }}
  description: {{ .Description }}
  version: {{ .Version }}
  output_path: ./{{ .OCBOutputDir }}

receivers:
{{ .Receivers.RenderOCBComponents }}
processors:
{{ .Processors.RenderOCBComponents }}
exporters:
{{ .Exporters.RenderOCBComponents }}
extensions:
{{ .Extensions.RenderOCBComponents }}
connectors:
{{ .Connectors.RenderOCBComponents }}
providers:
{{ .Providers.RenderOCBComponents }}
{{- if .Telemetry }}
telemetry:
{{ .Telemetry.RenderOCBModule }}
{{- end }}
replaces:
{{ .Replaces.Render }}
{{- if .BuildTagsList }}
build:
  build_tags:
    {{- range .BuildTagsList }}
    - {{ . }}
    {{- end }}
{{- end }}
