{
  "type": "metric_filter",
  "id": "keep-critical-service-tier",
  "action": "ACTION_KEEP",
  "matchers": [
    {
      "target": {
        "data_point_attribute_path": {
          "segments": ["service.tier"]
        }
      },
      "predicate": {
        "equality": {
          "string_value": "critical"
        }
      }
    }
  ]
}
