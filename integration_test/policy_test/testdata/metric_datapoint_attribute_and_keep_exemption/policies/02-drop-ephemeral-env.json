{
  "type": "metric_filter",
  "id": "drop-ephemeral-env-datapoints",
  "action": "ACTION_DROP",
  "matchers": [
    {
      "target": {
        "data_point_attribute_path": {
          "segments": ["env"]
        }
      },
      "equality": {
        "string_value": "ephemeral"
      }
    }
  ]
}
