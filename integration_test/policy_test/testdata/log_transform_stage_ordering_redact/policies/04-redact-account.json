{
  "type": "log_transform",
  "id": "a-redact-account",
  "redaction": {
    "redactions": [
      {
        "target": {
          "body_field_path": {
            "segments": [
              "account",
              "id"
            ]
          }
        },
        "regex": "\\d+",
        "replacement": "XXXX"
      }
    ]
  }
}
