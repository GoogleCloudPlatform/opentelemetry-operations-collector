{
  "type": "log_transform",
  "id": "route-prod-to-soc",
  "matchers": [
    {
      "target": {
        "resource_attribute_path": {
          "segments": ["env"]
        }
      },
      "equality": { "string_value": "prod" }
    }
  ],
  "add": {
    "target": {
      "log_attribute_path": {
        "segments": ["gcp", "routing", "tier"]
      }
    },
    "value": { "string_value": "soc" },
    "upsert": false
  }
}
