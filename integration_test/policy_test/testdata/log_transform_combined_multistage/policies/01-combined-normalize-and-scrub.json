{
  "type": "log_transform",
  "id": "combined-normalize-and-scrub",
  "matchers": [
    {
      "target": {
        "resource_attribute_path": {
          "segments": [
            "service.name"
          ]
        }
      },
      "predicate": {
        "equality": {
          "string_value": "auth-service"
        }
      }
    }
  ],
  "renamings": [
    {
      "source": {
        "log_attribute_path": {
          "segments": [
            "legacy_account_id"
          ]
        }
      },
      "target": {
        "body_field_path": {
          "segments": [
            "account",
            "id"
          ]
        }
      },
      "upsert_enabled": false
    }
  ],
  "additions": [
    {
      "target": {
        "body_field_path": {
          "segments": [
            "account",
            "id"
          ]
        }
      },
      "value": {
        "string_value": "guest-0000"
      },
      "upsert_enabled": false
    }
  ],
  "removals": [
    {
      "target": {
        "log_attribute_path": {
          "segments": [
            "temp_session_token"
          ]
        }
      }
    }
  ],
  "redactions": [
    {
      "target": {
        "body_field_path": {
          "segments": [
            "account",
            "id"
          ]
        }
      },
      "regex": "\\d+",
      "replacement": "XXXX"
    }
  ]
}
