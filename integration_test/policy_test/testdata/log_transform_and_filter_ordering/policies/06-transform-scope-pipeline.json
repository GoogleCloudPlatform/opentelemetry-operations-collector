{
  "type": "log_transform",
  "id": "set-scope-pipeline",
  "matchers": [
    {
      "target": {
        "resource_attribute_path": {
          "segments": ["env"]
        }
      },
      "equality": { "string_value": "prod" }
    }
  ],
  "add": {
    "target": {
      "log_attribute_path": {
        "segments": ["pipeline"]
      }
    },
    "value": { "string_value": "utr-v2" },
    "upsert": true
  }
}
