{{- define "localReplaces" -}}
{{- range . -}}
{{- if .Path -}}
- {{ .GoMod.URL }} => ../{{ .Path }}
{{ end -}}
{{- end -}}
{{- end -}}
# NOTE: File generated by distrogen. Do not manually edit.

dist:
  module: {{ .Module }}
  name: {{ .BinaryName }}
  description: {{ .Description }}
  version: {{ .Version }}
  output_path: ./{{ .OCBOutputDir }}

receivers:
{{ .Receivers.RenderOCBComponents }}
processors:
{{ .Processors.RenderOCBComponents }}
exporters:
{{ .Exporters.RenderOCBComponents }}
extensions:
{{ .Extensions.RenderOCBComponents }}
connectors:
{{ .Connectors.RenderOCBComponents }}
providers:
{{ .Providers.RenderOCBComponents }}
{{- with .RenderOCBTelemetry }}
{{ . }}
{{- end }}
replaces:
{{ template "localReplaces" .Receivers }}{{ template "localReplaces" .Processors }}{{ template "localReplaces" .Exporters }}{{ template "localReplaces" .Extensions }}{{ template "localReplaces" .Connectors }}{{ template "localReplaces" .Providers }}{{ with .Telemetry }}{{ if .Path }}- {{ .GoMod.URL }} => ../{{ .Path }}
{{ end }}{{ end }}{{ .Replaces.Render }}
{{- if .BuildTagsList }}
build:
  build_tags:
    {{- range .BuildTagsList }}
    - {{ . }}
    {{- end }}
{{- end }}
