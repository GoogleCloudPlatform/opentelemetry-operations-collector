[Unit]
Description=OpenTelemetry Collector Built By Google with experimental policy support
After=network.target

[Service]
EnvironmentFile=/etc/otelcol-google-policy/otelcol-google-policy.conf
ExecStart=/usr/bin/otelcol-google-policy $OTELCOL_OPTIONS
KillMode=mixed
Restart=on-failure
Type=simple
User=otelcol-google-policy
Group=otelcol-google-policy

[Install]
WantedBy=multi-user.target
