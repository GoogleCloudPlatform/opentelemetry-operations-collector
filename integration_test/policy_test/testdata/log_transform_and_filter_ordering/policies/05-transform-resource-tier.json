{
  "type": "log_transform",
  "id": "set-resource-tier",
  "matchers": [
    {
      "target": {
        "resource_attribute_path": {
          "segments": [
            "env"
          ]
        }
      },
      "predicate": {
        "equality": {
          "string_value": "prod"
        }
      }
    }
  ],
  "additions": [
    {
      "target": {
        "log_attribute_path": {
          "segments": [
            "cloud.account.tier"
          ]
        }
      },
      "value": {
        "string_value": "enterprise"
      },
      "upsert_enabled": true
    }
  ]
}
